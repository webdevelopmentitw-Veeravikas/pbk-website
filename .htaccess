RewriteEngine On
# Local XAMPP folder is htdocs/p. Omit RewriteBase so Apache uses this directory
# (works at /p locally and at the domain root on the live site).

# Protect sensitive directories
RewriteRule ^(app|config|database|storage|vendor)/ - [F,L]

# Serve existing files/directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to index.php
RewriteRule ^ index.php [L]